{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "f-si-simulator",
  "main": "cloudflare/src/index.js",
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "SimulatorContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SIMULATOR",
        "class_name": "SimulatorContainer"
      }
    ]
  },
  "exports": {
    "SimulatorContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "SIMULATOR_CORS_ORIGINS": "*"
  }
}
